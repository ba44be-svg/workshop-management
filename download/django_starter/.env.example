# ============================================================
# .env.example — متغیرهای محیطی پروژه
# از این فایل به‌عنوان الگو استفاده کنید و آن را به .env کپی کرده و مقادیر را جایگزین کنید
# هرگز فایل .env واقعی را در Git commit نکنید
# ============================================================

# ----- Django Core -----
SECRET_KEY=change-me-to-a-50-char-random-string-here-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,workshop.local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ----- Database -----
DATABASE_URL=postgres://workshop_user:workshop_password@localhost:5432/workshop_db
DB_CONN_MAX_AGE=60
DB_SSL=False

# ----- Redis & Cache -----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ----- Celery -----
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=django-db
CELERY_TIMEZONE=Asia/Tehran

# ----- JWT Authentication -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=120

# ----- Sentry (Error Tracking) -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----- SMS Provider (Kavenegar) -----
KAVENEGAR_API_KEY=your-api-key-here
KAVENEGAR_SENDER=1000596446
FARAPAYAMAK_API_KEY=  # Backup provider
FARAPAYAMAK_SENDER=

# ----- Firebase Push Notifications -----
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json
FIREBASE_PROJECT_ID=workshop-management

# ----- Payment Gateways -----
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_CALLBACK_URL=https://workshop.local/payments/zarinpal/callback/
IDPAY_API_KEY=your-idpay-api-key
IDPAY_CALLBACK_URL=https://workshop.local/payments/idpay/callback/
PARSIAN_PIN_CODE=your-parsian-pin
PARSIAN_CALLBACK_URL=https://workshop.local/payments/parsian/callback/

# ----- Saman Tax e-Invoice -----
SAMAN_BASE_URL=https://api.saman.tid.ir/api/v1
SAMAN_USERNAME=your-saman-username
SAMAN_PASSWORD=your-saman-password
SAMAN_CLIENT_ID=your-client-id
SAMAN_CLIENT_SECRET=your-client-secret

# ----- Object Storage (MinIO or S3) -----
AWS_ACCESS_KEY_ID=minio-access-key
AWS_SECRET_ACCESS_KEY=minio-secret-key
AWS_STORAGE_BUCKET_NAME=workshop-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# ----- Application -----
SITE_URL=http://localhost:8000
MANAGER_PHONE=09120000000
DEFAULT_FROM_EMAIL=no-reply@workshop.local

# ----- Django Settings Module -----
DJANGO_SETTINGS_MODULE=config.settings.production
